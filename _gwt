#compdef gwt
# ------------------------------------------------------------------------------
# Zsh Completion Definition for gwt (Git WorkTree Helper)
# https://github.com/sjwall/gwt
# ------------------------------------------------------------------------------

_gwt_comp_ides() {
  (( $+functions[_describe] )) || return 0
  local -a ides
  ides=(
    'nvim:Neovim'
    'vim:Vim'
    'code:Visual Studio Code'
    'cursor:Cursor'
    'idea:IntelliJ IDEA'
    'zed:Zed'
    'emacs:Emacs'
    'nano:Nano'
    'subl:Sublime Text'
    'webstorm:WebStorm'
    'none:Do not launch an IDE'
  )
  _describe -t ides 'IDE' ides
}

_gwt_comp_worktrees() {
  (( $+functions[_describe] )) || return 0
  local -a wt_entries
  local -A seen_paths
  local main_repo repo wt_list wt_path wt_name
  local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/gwt"
  local repos_file="$config_dir/repos"
  local -a repo_list

  main_repo=$(git worktree list --porcelain 2>/dev/null | head -n 1 | sed 's/^worktree //')
  if [[ -n "$main_repo" ]]; then
    repo_list+=("$main_repo")
  fi

  if [[ -f "$repos_file" ]]; then
    local r
    while IFS= read -r r || [[ -n "$r" ]]; do
      [[ -z "$r" || ! -d "$r" ]] && continue
      repo_list+=("$r")
    done < "$repos_file"
  fi

  for repo in "${repo_list[@]}"; do
    wt_list=$(git -C "$repo" worktree list --porcelain 2>/dev/null | grep "^worktree " | sed "s/^worktree //")
    while IFS= read -r wt_path || [[ -n "$wt_path" ]]; do
      [[ -z "$wt_path" || -n "${seen_paths[$wt_path]}" ]] && continue
      seen_paths[$wt_path]=1
      wt_name=$(basename "$wt_path")
      wt_entries+=("${wt_name//:/\\:}:${wt_path//:/\\:}")
    done <<< "$wt_list"
  done

  if [[ ${#wt_entries[@]} -gt 0 ]]; then
    _describe -t worktrees 'worktree' wt_entries
  fi
}

_gwt_comp_repositories() {
  (( $+functions[_describe] )) || return 0
  local -a repo_entries
  local -A seen_repos
  local main_repo repo repo_name
  local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/gwt"
  local repos_file="$config_dir/repos"
  local -a repo_list

  main_repo=$(git worktree list --porcelain 2>/dev/null | head -n 1 | sed 's/^worktree //')
  if [[ -n "$main_repo" ]]; then
    repo_list+=("$main_repo")
  fi

  if [[ -f "$repos_file" ]]; then
    local r
    while IFS= read -r r || [[ -n "$r" ]]; do
      [[ -z "$r" || ! -d "$r" ]] && continue
      repo_list+=("$r")
    done < "$repos_file"
  fi

  for repo in "${repo_list[@]}"; do
    [[ -n "${seen_repos[$repo]}" ]] && continue
    seen_repos[$repo]=1
    repo_name=$(basename "$repo")
    repo_entries+=("${repo_name//:/\\:}:${repo//:/\\:}")
  done

  if [[ ${#repo_entries[@]} -gt 0 ]]; then
    _describe -t repositories 'repository' repo_entries
  fi
}

_gwt_comp_remote_branches() {
  (( $+functions[_describe] )) || return 0
  local -a branches
  local b
  for b in ${(f)"$(git for-each-ref --format='%(refname:short)' refs/remotes/origin/ 2>/dev/null)"}; do
    [[ -z "$b" || "$b" == "origin/HEAD"* ]] && continue
    branches+=("${b#origin/}")
  done
  if [[ ${#branches[@]} -gt 0 ]]; then
    _describe -t remote-branches 'remote branch' branches
  fi
}

_gwt_comp_branches() {
  (( $+functions[_describe] )) || return 0
  local -a branches
  local b
  for b in ${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads/ refs/remotes/origin/ 2>/dev/null)"}; do
    [[ -z "$b" || "$b" == "origin/HEAD"* ]] && continue
    branches+=("${b#origin/}")
  done
  typeset -U branches
  if [[ ${#branches[@]} -gt 0 ]]; then
    _describe -t branches 'branch' branches
  fi
}

_gwt_comp_config() {
  (( $+functions[_describe] )) || return 0
  local -a config_actions config_keys
  config_actions=(
    'get:Get configuration key value'
    'set:Set configuration key value'
    'unset:Remove configuration key'
    'remove:Alias for unset'
    'rm:Alias for unset'
    'ide:Get or set configured IDE'
  )
  config_keys=('ide:Configured default IDE')

  local config_file="${XDG_CONFIG_HOME:-$HOME/.config}/gwt/config"
  if [[ -f "$config_file" ]]; then
    local line k
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -z "$line" || "$line" == \#* || "$line" != *"="* ]] && continue
      k="${line%%=*}"
      [[ "$k" != "ide" ]] && config_keys+=("$k")
    done < "$config_file"
  fi

  if (( CURRENT == 3 )); then
    _describe -t actions 'config action' config_actions
    _describe -t keys 'config key' config_keys
  elif (( CURRENT == 4 )); then
    case "${words[3]}" in
      get|unset|remove|rm)
        _describe -t keys 'config key' config_keys
        ;;
      set)
        _describe -t keys 'config key' config_keys
        ;;
      ide)
        _gwt_comp_ides
        ;;
      *)
        if [[ "${words[3]}" == "ide" ]]; then
          _gwt_comp_ides
        fi
        ;;
    esac
  elif (( CURRENT == 5 )); then
    if [[ "${words[3]}" == "set" && "${words[4]}" == "ide" ]]; then
      _gwt_comp_ides
    fi
  fi
}

_gwt() {
  (( $+functions[_arguments] )) || return 0
  local curcontext="$curcontext" state state_descr line
  typeset -A opt_args

  local -a subcommands
  subcommands=(
    'add:Create a new worktree branch'
    'pull:Fetch origin and create tracking worktree'
    'p:Alias for pull'
    'cd:Change directory to worktree'
    'main:Change directory to main repository'
    'm:Alias for main'
    'switch:Switch to worktree and launch IDE'
    's:Alias for switch'
    'ls:List all tracked worktrees'
    'list:Alias for ls'
    'remove:Remove a worktree'
    'rm:Alias for remove'
    'track:Track a git repository'
    't:Alias for track'
    'config:Get or set configuration options'
    'ide:Get or set configured IDE'
    'upgrade:Upgrade gwt repository'
  )

  _arguments -C \
    '--ide=[Override IDE to launch]:IDE:_gwt_comp_ides' \
    '--no-install[Skip dependency installation]' \
    '1:subcommand:->subcmd' \
    '*::arguments:->args' && return 0

  case "$state" in
    subcmd)
      _describe -t commands 'gwt subcommand' subcommands
      _gwt_comp_branches
      ;;
    args)
      local subcmd="${line[1]}"
      case "$subcmd" in
        cd)
          _arguments \
            '1:worktree:->worktrees' && return 0
          ;;
        switch|s)
          _arguments \
            '--ide=[Override IDE to launch]:IDE:_gwt_comp_ides' \
            '1:worktree:->worktrees' && return 0
          ;;
        main|m)
          _arguments \
            '1:repository:->repositories' && return 0
          ;;
        remove|rm)
          _arguments \
            '(-f --force -force)'{-f,--force,-force}'[Force removal of worktree]' \
            '*:worktree:->worktrees' && return 0
          ;;
        pull|p)
          _arguments \
            '--ide=[Override IDE to launch]:IDE:_gwt_comp_ides' \
            '--no-install[Skip dependency installation]' \
            '1:remote branch:->remote_branches' && return 0
          ;;
        add)
          _arguments \
            '--ide=[Override IDE to launch]:IDE:_gwt_comp_ides' \
            '--no-install[Skip dependency installation]' \
            '1:branch:->branches' && return 0
          ;;
        track|t)
          _arguments \
            '1:repository:_files -/' && return 0
          ;;
        config)
          _gwt_comp_config
          return 0
          ;;
        ide)
          _arguments \
            '1:IDE:_gwt_comp_ides' && return 0
          ;;
        ls|list)
          _arguments \
            '--porcelain[Output in machine-readable format]' \
            '1:repository:->repositories' \
            '*:git worktree list flags: ' && return 0
          ;;
        upgrade)
          ;;
        *)
          _arguments \
            '--ide=[Override IDE to launch]:IDE:_gwt_comp_ides' \
            '--no-install[Skip dependency installation]' \
            '1:branch:->branches' && return 0
          ;;
      esac

      case "$state" in
        worktrees)
          _gwt_comp_worktrees
          ;;
        repositories)
          _gwt_comp_repositories
          ;;
        remote_branches)
          _gwt_comp_remote_branches
          ;;
        branches)
          _gwt_comp_branches
          ;;
      esac
      ;;
  esac
}

# If executing inside Zsh completion context (e.g. autoloaded on first Tab press)
if (( $+compstate )); then
  _gwt "$@"
fi


