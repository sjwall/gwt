#compdef gwt
# ------------------------------------------------------------------------------
# Zsh Completion Definition for gwt (Git WorkTree Helper)
# https://github.com/sjwall/gwt
# ------------------------------------------------------------------------------

# Determine the directory where this completion file is located
local gwt_dir="${GWT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/gwt}"

_gwt() {
  (( $+functions[_arguments] )) || return 0
  local curcontext="$curcontext" state state_descr line
  typeset -A opt_args

  local -a subcommands
  subcommands=(
    'add:Create a new worktree branch'
    'pull:Fetch origin and create tracking worktree'
    'p:Alias for pull'
    'cd:Change directory to worktree'
    'main:Change directory to main repository'
    'm:Alias for main'
    'M:Switch to main repository and launch IDE'
    'switch:Switch to worktree and launch IDE'
    's:Alias for switch'
    'agent:Switch to worktree and launch agent'
    'a:Alias for agent'
    'ls:List all tracked worktrees'
    'list:Alias for ls'
    'remove:Remove a worktree'
    'rm:Alias for remove'
    'track:Track a git repository'
    't:Alias for track'
    'clone:Clone a repository with git clone and track it'
    'config:Get or set configuration options'
    'ide:Get or set configured IDE'
    'skills:Manage agent skill symlinks'
    'migrate:Migrate worktrees to match expected path pattern'
    'upgrade:Upgrade gwt repository'
    'devcon:Configure the current repository to work with devcontainers and gwt'
    'env:Manage environment files for worktrees'
  )

  # Source IDE completion utility
  source "$gwt_dir/utils/comp-idess.sh"

  _arguments -C \
    '--ide=[Override IDE to launch]:IDE:_gwt_comp_ides' \
    '(-a --agent)'{-a,--agent}'[Launch agent instead of IDE]::agent command: ' \
    '--no-install[Skip dependency installation]' \
    '1:subcommand:->subcmd' \
    '*::arguments:->args' && return 0

  case "$state" in
    subcmd)
      _describe -t commands 'gwt subcommand' subcommands
      # Source branches completion utility
      source "$gwt_dir/utils/comp-branches.sh"
      _gwt_comp_branches
      ;;
    args)
      local subcmd="${line[1]}"
      case "$subcmd" in
        cd)
          _arguments \
            '1:worktree:->worktrees' && return 0
          ;;
        switch|s)
          _arguments \
            '--ide=[Override IDE to launch]:IDE:_gwt_comp_ides' \
            '1:worktree:->worktrees' && return 0
          ;;
        agent|a)
          _arguments \
            '--agent=[Override agent to launch]:agent command: ' \
            '1:worktree:->worktrees' && return 0
          ;;
        main|m)
          _arguments \
            '1:repository:->repositories' && return 0
          ;;
        Main|M)
          _arguments \
            '--ide=[Override IDE to launch]:IDE:_gwt_comp_ides' \
            '1:repository:->repositories' && return 0
          ;;
        remove|rm)
          _arguments \
            '(-f --force -force)'{-f,--force,-force}'[Force removal of worktree]' \
            '*:worktree:->worktrees' && return 0
          ;;
        pull|p)
          _arguments \
            '--ide=[Override IDE to launch]:IDE:_gwt_comp_ides' \
            '--no-install[Skip dependency installation]' \
            '1:remote branch:->remote_branches' && return 0
          ;;
        add)
          _arguments \
            '--ide=[Override IDE to launch]:IDE:_gwt_comp_ides' \
            '(-a --agent)'{-a,--agent}'[Launch agent instead of IDE]::agent command: ' \
            '--no-install[Skip dependency installation]' \
            '1:branch:->branches' && return 0
          ;;
        track|t)
          _arguments \
            '1:repository:_files -/' && return 0
          ;;
        config)
          source "$gwt_dir/commands/_config.sh"
          _gwt_comp_config
          return 0
          ;;
        ide)
          _arguments \
            '1:IDE:_gwt_comp_ides' && return 0
          ;;
        ls|list)
          _arguments \
            '--porcelain[Output in machine-readable format]' \
            '1:repository:->repositories' \
            '*:git worktree list flags: ' && return 0
          ;;
        skills)
          _arguments \
            '(-n --dry-run)'{-n,--dry-run}'[Perform a dry run without making changes]' \
            '1:targets:->skills_targets' && return 0
          ;;
        migrate)
          _arguments \
            '(-n --dry-run)'{-n,--dry-run}'[Perform a dry run without making changes]' \
            '(-f --force -force)'{-f,--force,-force}'[Force move even if worktree is dirty or locked]' && return 0
          ;;
        upgrade)
          ;;
        devcon)
          ;;
        env)
          _arguments \
            '1:subcommand:(add list ls sync remove rm)' \
            '2:environment file:_files' && return 0
          ;;
        clone)
          source "$gwt_dir/commands/_clone.sh"
          _gwt_comp_clone
          return 0
          ;;
        *)
          _arguments \
            '--ide=[Override IDE to launch]:IDE:_gwt_comp_ides' \
            '(-a --agent)'{-a,--agent}'[Launch agent instead of IDE]::agent command: ' \
            '--no-install[Skip dependency installation]' \
            '1:branch:->branches' && return 0
          ;;
      esac

      case "$state" in
        skills_targets)
          local -a targets
          targets=(
            'agents:Symlink skills to ~/.agents/skills'
            'opencode:Symlink skills to ~/.config/opencode/skills'
            'claude:Symlink skills to ~/.claude/skills'
            'gemini:Symlink skills to ~/.gemini/antigravity-cli/skills, ~/.gemini/config/skills'
            'all:Symlink skills to all supported environments'
            'none:Remove all skill symlinks'
            'list:List status of all agent skill symlinks'
            'sync:Sync skills for already linked agents'
          )
          _describe -t targets 'target' targets
          ;;
        worktrees)
          # Source worktrees completion utility
          source "$gwt_dir/utils/comp-worktrees.sh"
          _gwt_comp_worktrees
          ;;
        repositories)
          # Source repositories completion utility
          source "$gwt_dir/utils/comp-repositories.sh"
          _gwt_comp_repositories
          ;;
        remote_branches)
          # Source remote branches completion utility
          source "$gwt_dir/utils/comp-remote-branches.sh"
          _gwt_comp_remote_branches
          ;;
        branches)
          # Source branches completion utility
          source "$gwt_dir/utils/comp-branches.sh"
          _gwt_comp_branches
          ;;
      esac
      ;;
  esac
}

# If executing inside Zsh completion context (e.g. autoloaded on first Tab press)
if (( $+compstate )); then
  _gwt "$@"
fi
